# Import into project doxa-website-prod, environment prod, folder /crm.
# Replace every <generate-...> placeholder in Infisical before deployment.
# Use its random value generator; do not commit a populated copy of this file.
POSTGRES_USER=doxa_crm
POSTGRES_DB=doxa_crm
POSTGRES_PASSWORD=<generate-64-hex>
DATABASE_URL=postgresql://doxa_crm:${prod.crm.POSTGRES_PASSWORD}@doxa-crm-postgresql:5432/doxa_crm
REDIS_URL=redis://doxa-crm-redis:6379/0
SECRET_KEY=<generate-64-hex>
BETTER_AUTH_SECRET=${prod.crm.SECRET_KEY}
WEBHOOK_SECRET=<generate-64-hex>
ENVIRONMENT=production
NODE_ENV=production
CORS_ORIGINS=https://crm.doxaplc.com
BETTER_AUTH_URL=https://crm.doxaplc.com
API_INTERNAL_URL=http://doxa-crm-api
MEILISEARCH_URL=http://doxa-crm-meilisearch:7700
MEILISEARCH_API_KEY=<generate-64-hex>
GOOGLE_CLIENT_ID=${prod.forms.GOOGLE_CLIENT_ID}
GOOGLE_CLIENT_SECRET=${prod.forms.GOOGLE_CLIENT_SECRET}
CRM_SSO_ADMIN_EMAILS=doxainnovationsplc@gmail.com
ADMIN_EMAIL=dev@doxaplc.com
ADMIN_FULL_NAME="Doxa Administrator"
ADMIN_PASSWORD=<generate-strong-password>
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
BETTER_AUTH_DB_POOL_MAX=5
LOG_LEVEL=INFO
CELERY_WORKER_CONCURRENCY=2

# Campaign unsubscribe links, verified email senders, and real document storage.
PUBLIC_APP_URL=https://crm.example.com
MAILERSEND_API_KEY=
MAILERSEND_FROM_EMAIL=
MAILERSEND_FROM_NAME=Doxa CRM
MAILERSEND_WEBHOOK_SECRET=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Optional public contact address on read-only project portals.
CUSTOMER_SUPPORT_EMAIL=
