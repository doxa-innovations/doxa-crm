# Direct DB connection. Supabase direct DB hosts are IPv6; use this when your network supports IPv6.
DATABASE_URL=postgresql+asyncpg://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?ssl=require

# If direct DB connection fails locally, use the Supabase Session Pooler connection string instead.
# It looks like: postgresql+asyncpg://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@[REGION].pooler.supabase.com:5432/postgres?ssl=require
DB_POOL_SIZE=1
DB_MAX_OVERFLOW=1
REDIS_URL=redis://redis:6379/0
SECRET_KEY=change-me-to-a-random-32-byte-or-longer-secret-key
ENVIRONMENT=development
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_KEY=[YOUR-SUPABASE-ANON-OR-SERVICE-ROLE-KEY]
MEILISEARCH_URL=http://meilisearch:7700
MEILISEARCH_API_KEY=local-development-master-key
WEBHOOK_SECRET=change-me-webhook-secret-at-least-32-chars

# Optional campaign messaging providers.
AFROMESSAGE_API_KEY=
# Optional AfroMessage system Identifier ID. Leave empty to use your default identifier.
AFROMESSAGE_IDENTIFIER_ID=
# Optional verified sender name. Leave empty to use AfroMessage's default sender name.
AFROMESSAGE_SENDER_NAME=
AFROMESSAGE_BASE_URL=https://api.afromessage.com
AFROMESSAGE_SEND_PATH=/api/send
AFROMESSAGE_METHOD=POST

# Comma-separated browser origins allowed to call the API.
# REQUIRED when ENVIRONMENT is not "development" — the API refuses to start without it.
CORS_ORIGINS=https://crm.example.com

# Log level for the API and Celery processes. One of DEBUG, INFO, WARNING, ERROR, CRITICAL.
LOG_LEVEL=INFO

# Which process this container runs: api, worker, or beat. Defaults to api.
PROCESS_ROLE=api

# Run "alembic upgrade head" on start. Enable on exactly ONE service.
RUN_MIGRATIONS=false

# Production pool sizing. The 1/1 defaults above are a Supabase session-pooler
# workaround and are inadequate for a dedicated Postgres.
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=5
