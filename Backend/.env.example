# PostgreSQL is the primary CRM database. The backend accepts a normal
# postgresql:// URL and converts it to asyncpg internally.
DATABASE_URL=postgresql://postgres:change-me@postgres:5432/postgres
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
REDIS_URL=redis://redis:6379/0
SECRET_KEY=change-me-to-a-random-32-byte-or-longer-secret-key
ENVIRONMENT=development
MEILISEARCH_URL=http://meilisearch:7700
MEILISEARCH_API_KEY=local-development-master-key
WEBHOOK_SECRET=change-me-webhook-secret-at-least-32-chars

# Optional legacy compatibility only. Doxa CRM does not require Supabase.
SUPABASE_URL=
SUPABASE_KEY=

# Optional campaign messaging providers.
AFROMESSAGE_API_KEY=
AFROMESSAGE_IDENTIFIER_ID=
AFROMESSAGE_SENDER_NAME=
AFROMESSAGE_BASE_URL=https://api.afromessage.com
AFROMESSAGE_SEND_PATH=/api/send
AFROMESSAGE_METHOD=POST

# Comma-separated browser origins allowed to call the API.
# REQUIRED when ENVIRONMENT is not "development".
CORS_ORIGINS=https://crm.example.com
LOG_LEVEL=INFO

# Which process this container runs: api, worker, or beat.
PROCESS_ROLE=api

# Run "alembic upgrade head" on start. Enable on exactly ONE service (API).
RUN_MIGRATIONS=false
